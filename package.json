{
  "name": "xinxiangyi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "api": "node --disable-warning=ExperimentalWarning scripts/api-local.mjs",
    "dev": "node scripts/dev-local.mjs",
    "electron": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:dev": "env -u ELECTRON_RUN_AS_NODE ELECTRON_DEV_SERVER_URL=http://localhost:5173 electron .",
    "postinstall": "node scripts/patch-capacitor-android.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "icons:sync": "node scripts/sync-icons.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "preview": "vite preview",
    "smoke:local": "node scripts/smoke-local.mjs",
    "patch:capacitor": "node scripts/patch-capacitor-android.mjs",
    "cap:sync": "npm run build && npm run patch:capacitor && cap sync android",
    "android:apk": "npm run build && npm run patch:capacitor && cap sync android && cd android && ./gradlew assembleDebug",
    "mac:dmg": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.markxu.xinxiangyi",
    "productName": "心象仪",
    "compression": "maximum",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack-electron.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "config/**",
      "electron/**",
      "server/**",
      "package.json",
      "!node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/brand/app-icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.3"
  }
}
